FROM python:3.12-slim

WORKDIR /app

COPY requirements-dashboard.txt .

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-dashboard.txt

COPY src/dashboard/ ./src/dashboard/

# Paramètres de preprocessing utilisés par le modèle
COPY data/processed/preprocessing_params.pkl ./data/processed/preprocessing_params.pkl

EXPOSE 8501

CMD ["streamlit", "run", "src/dashboard/app.py", "--server.address=0.0.0.0", "--server.port=8501"]